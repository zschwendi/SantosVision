+//! Test-only original idle-camera command, from an existing immutable table slot.
+//! Original11ca8d... element table0 slot45348 -> func49111 [] -> []. Patch5
+//! reencodes function indices and retains element order; certified AOTdc4806...
+//! is patch2a5d56... . No exports/imports/AOT are generated by this helper.
+use std::sync::OnceLock;
+use wasmtime::{AsContextMut,Table};
+static CERTIFIED:OnceLock<bool>=OnceLock::new();
+pub(crate) const TABLE_SLOT:u64=45348;
+pub(crate) fn certify(original:&[u8],aot_sha:&str)->anyhow::Result<()>{
+    anyhow::ensure!(crate::xr_motion_patch::sha256(original)?=="11ca8d2c04c5e843d18ff4aea4899d72c86973c6b031df334e67c446b2ae83e0","idle original mapping unqualified");
+    anyhow::ensure!(aot_sha=="dc4806cba7b44366fd039dc5212a20fbfcc96139d3208047b5e52e41db2fdfff","idle AOT mapping unqualified");
+    CERTIFIED.set(true).map_err(|_|anyhow::anyhow!("one idle certificate/process"))?;Ok(())
+}
+pub(crate) fn certified()->bool{CERTIFIED.get()==Some(&true)}
+pub(crate) fn may_invalidate(s:crate::qa_scene_setup::Sample,ms:u64,cinematic:Option<u64>,rejected:bool)->bool{
+    !rejected&&ms>=5000&&cinematic.is_some_and(|v|v!=0)&&s.ped.is_some_and(|p|p>0)&&s.exists==Some(true)&&s.health.is_some_and(|h|h>0)&&s.in_vehicle==Some(false)
+}
+pub(crate) fn invoke<S:AsContextMut<Data=crate::HostState>>(store:&mut S,table:Option<Table>,certified:bool)->Result<(),String>{
+    if !certified{return Err("exact original/patch5/AOT mapping not certified".into());}
+    let table=table.ok_or("existing exported indirect table unavailable")?;
+    let func=table.get(&mut *store,TABLE_SLOT).and_then(|r|r.as_func().flatten().cloned()).ok_or("certified idle table slot missing/null")?;
+    let typed=func.typed::<(),()>(&*store).map_err(|e|format!("idle table signature mismatch: {e}"))?;
+    crate::guest_call_scope::call(store,crate::guest_call_scope::Kind::Ordinary,|s|typed.call(s,())).map_err(|e|format!("original InvalidateIdleCam failed: {e}"))
+}
+#[cfg(all(test,feature="jit"))]mod tests{
+ use super::*;use std::sync::{Arc,atomic::{AtomicU64,Ordering}};use wasmtime::{Engine,Store,TableType,RefType,Ref,Func};
+ #[test]fn idle_prevention_does_not_depend_on_setup_or_gameplay_dominance(){
+   use crate::qa_scene_setup::Sample;let base=Sample{ped:Some(258),exists:Some(true),health:Some(200),in_vehicle:Some(false),gameplay:Some(false),on_screen:Some(false),scripted_dominant:Some(false),position_at_target:Some(false)};
+   assert!(may_invalidate(base,5000,Some(4096),false));assert!(!may_invalidate(base,4999,Some(4096),false));assert!(!may_invalidate(base,5000,Some(0),false));assert!(!may_invalidate(base,5000,None,false));assert!(!may_invalidate(base,5000,Some(4096),true));
+   for n in 0..4{let mut s=base;match n{0=>s.ped=None,1=>s.exists=None,2=>s.health=None,_=>s.in_vehicle=None};assert!(!may_invalidate(s,5000,Some(4096),false));}
+ }
+ #[test]fn real_wasmtime_table_call_is_exact_typed_and_fail_closed(){
+  let e=Engine::default();let mut s=Store::new(&e,crate::HostState::new(0));let count=Arc::new(AtomicU64::new(0));let c=count.clone();
+  let valid=Func::wrap(&mut s,move||{c.fetch_add(1,Ordering::Relaxed);});
+  let table=Table::new(&mut s,TableType::new64(RefType::FUNCREF,TABLE_SLOT+1,Some(TABLE_SLOT+1)),Ref::Func(None)).unwrap();
+  assert!(invoke(&mut s,Some(table),false).is_err());assert!(invoke(&mut s,None,true).is_err());assert!(invoke(&mut s,Some(table),true).is_err());assert_eq!(count.load(Ordering::Relaxed),0);
+  let wrong=Func::wrap(&mut s,|_:i32|{});table.set(&mut s,TABLE_SLOT,Ref::Func(Some(wrong))).unwrap();assert!(invoke(&mut s,Some(table),true).is_err());assert_eq!(count.load(Ordering::Relaxed),0);
+  table.set(&mut s,TABLE_SLOT,Ref::Func(Some(valid))).unwrap();assert!(invoke(&mut s,Some(table),true).is_ok());assert_eq!(count.load(Ordering::Relaxed),1);
+  let trap=Func::wrap(&mut s,||->wasmtime::Result<()>{Err(wasmtime::Error::msg("injected idle command failure"))});table.set(&mut s,TABLE_SLOT,Ref::Func(Some(trap))).unwrap();assert!(invoke(&mut s,Some(table),true).is_err());assert_eq!(count.load(Ordering::Relaxed),1);
+ }
