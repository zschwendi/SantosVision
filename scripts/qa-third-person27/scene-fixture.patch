+//! Private test-only deterministic third-person scene setup. Never production.
+use serde_json::{json,Value};
+use std::sync::{Mutex,OnceLock};
+use std::time::Instant;
+
+pub(crate) const POSITION:[f32;3]=[-1037.0,-2737.0,20.1693];
+pub(crate) const HEADING:f32=180.;
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub(crate) enum Action{Wait,Setup,ResetScriptCamera,HoldClock,Reject}
+#[derive(Clone,Copy,Debug)]
+pub(crate) struct Sample{pub ped:Option<i32>,pub exists:Option<bool>,pub health:Option<i32>,pub in_vehicle:Option<bool>,pub gameplay:Option<bool>,pub on_screen:Option<bool>,pub scripted_dominant:Option<bool>,pub position_at_target:Option<bool>}
+#[derive(Default)]
+pub(crate) struct Policy{ped:Option<i32>,stable_ticks:u32,setup_ms:Option<u64>,resets:u8,last_reset_ms:u64,rejected:bool}
+impl Policy{
+ pub(crate) fn step(&mut self,ms:u64,s:Sample)->Action{
+  if self.rejected{return Action::Reject;}
+  if let Some(bound)=self.ped{if self.setup_ms.is_some()&&s.ped!=Some(bound){self.rejected=true;return Action::Reject;}}
+  let valid=s.ped.is_some_and(|p|p>0)&&s.exists==Some(true)&&s.health.is_some_and(|h|h>0)&&s.in_vehicle==Some(false);
+  if !valid{self.stable_ticks=0;return Action::Wait;}
+  if self.ped!=s.ped{self.ped=s.ped;self.stable_ticks=0;}
+  self.stable_ticks=self.stable_ticks.saturating_add(1);
+  if self.setup_ms.is_none(){if s.gameplay!=Some(true)&&s.scripted_dominant!=Some(true){return Action::Wait;}if ms>=45_000&&self.stable_ticks>=30{self.setup_ms=Some(ms);self.last_reset_ms=ms;return Action::Setup;}return Action::Wait;}
+  if s.gameplay!=Some(true)&&s.scripted_dominant==Some(true)&&ms.saturating_sub(self.last_reset_ms)>=1000&&self.resets<3{self.resets+=1;self.last_reset_ms=ms;return Action::ResetScriptCamera;}
+  Action::HoldClock
+ }
+ pub(crate) fn settled(&self,ms:u64,s:Sample)->bool{!self.rejected&&self.setup_ms.is_some_and(|t|ms.saturating_sub(t)>=20_000)&&s.ped==self.ped&&s.exists==Some(true)&&s.health.is_some_and(|h|h>0)&&s.in_vehicle==Some(false)&&s.gameplay==Some(true)&&s.on_screen==Some(true)&&s.position_at_target==Some(true)}
+}
+struct State{policy:Policy,samples:Vec<Value>,last_sample_ms:u64,latest:Value}
+static SKIPS:Mutex<std::collections::BTreeMap<String,u64>>=Mutex::new(std::collections::BTreeMap::new());
+pub(crate) fn record_skip(line:u32,vertex:&str,pixel:&str){let key=format!("draw_skip_line{line}:{vertex}:{pixel}");let mut m=SKIPS.lock().unwrap();if let Some(n)=m.get_mut(&key){*n=n.saturating_add(1);}else if m.len()<256{m.insert(key,1);}}
+static START:OnceLock<Instant>=OnceLock::new();
+static STATE:Mutex<Option<State>>=Mutex::new(None);
+pub(crate) fn initialize(){START.set(Instant::now()).expect("one scene fixture/process");*STATE.lock().unwrap()=Some(State{policy:Policy::default(),samples:Vec::new(),last_sample_ms:0,latest:Value::Null});}
+pub(crate) fn elapsed_ms()->u64{START.get().map(|t|t.elapsed().as_millis().min(u128::from(u64::MAX))as u64).unwrap_or(0)}
+pub(crate) fn decide(s:Sample)->Action{let ms=elapsed_ms();STATE.lock().unwrap().as_mut().map(|s0|s0.policy.step(ms,s)).unwrap_or(Action::Wait)}
+pub(crate) fn record(sample:Sample,raw:Value,action:Action,commands:Value){let ms=elapsed_ms();let mut lock=STATE.lock().unwrap();let Some(s)=lock.as_mut()else{return;};if commands.as_object().is_some_and(|m|m.values().any(Value::is_null)){s.policy.rejected=true;}let settled=s.policy.settled(ms,sample);let event=json!({"elapsed_ms":ms,"action":format!("{action:?}"),"ped":sample.ped,"exists":sample.exists,"health":sample.health,"in_vehicle":sample.in_vehicle,"gameplay_rendering":sample.gameplay,"entity_on_screen":sample.on_screen,"scripted_dominant":sample.scripted_dominant,"actual_position_at_target":sample.position_at_target,"scene_settled":settled,"raw":raw,"command_results":commands});s.latest=event.clone();if s.samples.len()<256&&(ms.saturating_sub(s.last_sample_ms)>=1000||matches!(action,Action::Setup|Action::ResetScriptCamera|Action::Reject)){s.last_sample_ms=ms;s.samples.push(event);}}
+pub(crate) fn rejected()->bool{STATE.lock().unwrap().as_ref().is_some_and(|s|s.policy.rejected)}
+pub(crate) fn qualified()->bool{STATE.lock().unwrap().as_ref().is_some_and(|s|s.latest["scene_settled"]==true)}
+pub(crate) fn snapshot()->Value{STATE.lock().unwrap().as_ref().map(|s|json!({"schema":1,"scene":"airport-fixed-tp-v1","position":POSITION,"heading":HEADING,"clock":[12,0,0],"weather":"EXTRASUNNY","latest":s.latest,"test_only_scene_mutation":true})).unwrap_or(Value::Null)}
+pub(crate) fn status()->Value{let lock=STATE.lock().unwrap();lock.as_ref().map(|s|json!({"schema":1,"scene":"airport-fixed-tp-v1","position":POSITION,"heading":HEADING,"clock":[12,0,0],"weather":"EXTRASUNNY","latest":s.latest,"bounded_samples":s.samples,"max_samples":256,"test_only_scene_mutation":true,"draw_skips_by_site_and_shader_cumulative":*SKIPS.lock().unwrap(),"skip_telemetry_scope":"draw skip helper only; direct compute skip branches remain counted by unchanged original gate but unclassified here","physical_acceptance":false})).unwrap_or(Value::Null)}
+#[cfg(test)]mod tests{use super::*;fn good()->Sample{Sample{ped:Some(258),exists:Some(true),health:Some(200),in_vehicle:Some(false),gameplay:Some(true),on_screen:Some(true),scripted_dominant:Some(false),position_at_target:Some(true)}}fn ready()->Policy{let mut p=Policy::default();for _ in 0..29{assert_eq!(p.step(45_000,good()),Action::Wait);}assert_eq!(p.step(45_000,good()),Action::Setup);p}
+#[test]fn setup_waits_for_time_and_stable_real_live_onfoot_ped(){let mut p=Policy::default();for ms in 0..45_000{assert_eq!(p.step(ms,good()),Action::Wait);}assert_eq!(p.step(45_000,good()),Action::Setup);}
+#[test]fn missing_typed_getters_never_qualify(){for field in 0..7{let mut s=good();match field{0=>s.ped=None,1=>s.exists=None,2=>s.health=None,3=>s.in_vehicle=None,4=>s.gameplay=None,5=>s.on_screen=None,_=>s.position_at_target=None};let mut p=ready();p.step(80_000,s);assert!(!p.settled(80_000,s));}}
+#[test]fn switching_raw_ped_after_setup_rejects_without_reapplying(){let mut p=ready();let mut s=good();s.ped=Some(259);assert_eq!(p.step(46_000,s),Action::Reject);assert_eq!(p.step(47_000,good()),Action::Reject);assert!(!p.settled(80_000,good()));}
+#[test]fn resets_bounded_three_spaced_attempts(){let mut p=ready();let mut s=good();s.gameplay=Some(false);s.scripted_dominant=Some(true);for t in [46_000,47_000,48_000]{assert_eq!(p.step(t,s),Action::ResetScriptCamera);}assert_eq!(p.step(49_000,s),Action::HoldClock);assert!(!p.settled(80_000,s));}
+#[test]fn wrong_or_unknown_actual_position_never_settles(){let p=ready();let mut s=good();s.position_at_target=Some(false);assert!(!p.settled(80_000,s));s.position_at_target=None;assert!(!p.settled(80_000,s));}
+#[test]fn unknown_or_other_director_never_starts_or_resets(){let mut p=Policy::default();let mut s=good();s.gameplay=Some(false);for _ in 0..60{assert_eq!(p.step(90_000,s),Action::Wait);}s.scripted_dominant=None;assert_eq!(p.step(90_000,s),Action::Wait);}
+#[test]fn actual_gameplay_and_on_screen_and_settle_required(){let p=ready();assert!(!p.settled(64_999,good()));assert!(p.settled(65_000,good()));let mut s=good();s.on_screen=Some(false);assert!(!p.settled(80_000,s));s.on_screen=Some(true);s.gameplay=Some(false);assert!(!p.settled(80_000,s));}
+}
